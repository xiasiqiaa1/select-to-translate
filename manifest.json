{
  "manifest_version": 3,

  "name": "选中翻译",
  "version": "1.0",
  "description": "选中网页文字自动弹出翻译弹窗，支持多语种互译。兼容 Chrome / Edge / Brave 等 Chromium 内核浏览器",

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
